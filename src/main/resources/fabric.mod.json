{
  "schemaVersion": 1,
  "id": "nomaxenchant",
  "version": "${version}",
  "name": "No Max Enchant",
  "description": "Removes the anvil's max enchantment level clamp, letting books above the vanilla cap (e.g. Sharpness 6) apply at their real level.",
  "authors": [
    "jahus"
  ],
  "license": "Apache-2.0",
  "icon": "assets/nomaxenchant/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "net.jahus.nomaxenchant.NoMaxEnchant"
    ]
  },
  "mixins": [
    "nomaxenchant.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
